{
    "name": "lumenpink/fuxico",
    "description": "Fuxico: A malícia popular do boca a boca - File sharing and URL shortener with 0x0.st and rustypaste protocol support",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Lumen Pink",
            "email": "hi@lumen.pink"
        }
    ],
    "autoload": {
        "psr-4": {
            "Fuxico\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest",
        "test:coverage": "./vendor/bin/pest --coverage-clover coverage/clover.xml --coverage-html coverage/html --log-junit coverage/junit.xml",
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint",
        "psalm": "./vendor/bin/psalm --config=psalm.xml",
        "dev": "./scripts/dev.sh",
        "compile": "php compile.php",
        "fetch-clients": "./scripts/fetch_external_clients.sh",
        "build:clients": "./scripts/build_clients.sh",
        "build:clients:all": "./scripts/build_clients.sh --all",
        "bundle": "./scripts/build_bundles.sh",
        "ci": [
            "@lint",
            "@psalm",
            "@test"
        ]
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0 || ^2.34",
        "vimeo/psalm": "^6.17"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
