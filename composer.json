{
    "name": "lumenpink/picoshare",
    "description": "Simple url shortener and file sharing system with 0x0.st and rustypaste protocol support",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Lumen Pink",
            "email": "hi@lumen.pink"
        }
    ],
    "autoload": {
        "psr-4": {
            "PicoShare\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0 || ^2.34"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
