#!/usr/bin/env bash
#
# picoshare - Lightweight CLI client for PicoShare / 0x0.st / rustypaste
#

set -euo pipefail

SERVER_URL="${PICOSHARE_URL:-http://localhost:8080}"
AUTH_TOKEN="${PICOSHARE_TOKEN:-tatanka}"

SHOW_HELP=false
EXPIRATION=""
ONESHOT=false
SECRET=false
CUSTOM_NAME=""
TARGET_URL=""
DELETE_TARGET=""
LIST_FILES=false
COPY_CLIPBOARD=false

usage() {
    cat <<EOF
picoshare - Fast file sharing and URL shortener CLI

Usage:
    picoshare [options] <file>
    cat file.txt | picoshare [options]
    picoshare -u <url> [options]
    picoshare -d <slug> [options]
    picoshare -l [options]

Options:
    -u <url>       Shorten a destination URL
    -e <time>      Set expiration (e.g., "24" for 24 hours, "10m", "7d", "1y")
    -o             Oneshot (burn-after-reading / delete after single download)
    -s             Secret URL (generate a 16-character high-entropy slug)
    -n <name>      Custom slug/filename
    -t <token>     Authorization / Management token (or env PICOSHARE_TOKEN)
    -S <server>    Server URL (default: \$PICOSHARE_URL or http://localhost:8080)
    -d <slug>      Delete an item by slug using token
    -l             List active files (JSON format)
    -c             Copy returned URL to clipboard (xclip/wl-copy/pbcopy)
    -h, --help     Show this help message

Examples:
    picoshare photo.png
    picoshare -e 24 -s backup.gpg
    picoshare -o secret.txt
    picoshare -u https://news.ycombinator.com -n hn
    picoshare -d abcde -t <X-Token>
    picoshare -l
EOF
}

while getopts ":u:e:osn:t:S:d:lch-:" opt; do
    case "$opt" in
        u) TARGET_URL="$OPTARG" ;;
        e) EXPIRATION="$OPTARG" ;;
        o) ONESHOT=true ;;
        s) SECRET=true ;;
        n) CUSTOM_NAME="$OPTARG" ;;
        t) AUTH_TOKEN="$OPTARG" ;;
        S) SERVER_URL="${OPTARG%/}" ;;
        d) DELETE_TARGET="$OPTARG" ;;
        l) LIST_FILES=true ;;
        c) COPY_CLIPBOARD=true ;;
        h) usage; exit 0 ;;
        -)
            case "$OPTARG" in
                help) usage; exit 0 ;;
                oneshot) ONESHOT=true ;;
                secret) SECRET=true ;;
                *) echo "Unknown option --$OPTARG" >&2; exit 1 ;;
            esac
            ;;
        \?) echo "Invalid option -$OPTARG" >&2; exit 1 ;;
        :) echo "Option -$OPTARG requires an argument." >&2; exit 1 ;;
    esac
done
shift $((OPTIND -1))

copy_to_clip() {
    local text="$1"
    if command -v wl-copy &>/dev/null; then
        echo -n "$text" | wl-copy
    elif command -v xclip &>/dev/null; then
        echo -n "$text" | xclip -selection clipboard
    elif command -v pbcopy &>/dev/null; then
        echo -n "$text" | pbcopy
    fi
}

# 1. Delete operation
if [[ -n "$DELETE_TARGET" ]]; then
    if [[ -z "$AUTH_TOKEN" ]]; then
        echo "Error: Token (-t or PICOSHARE_TOKEN) is required for deletion." >&2
        exit 1
    fi
    # Attempt 0x0.st management deletion first
    resp=$(curl -s -w "\n%{http_code}" -F "token=${AUTH_TOKEN}" -F "delete=" "${SERVER_URL}/${DELETE_TARGET}")
    http_code=$(echo "$resp" | tail -n1)
    body=$(echo "$resp" | sed '$d')

    if [[ "$http_code" -eq 200 ]]; then
        echo "Deleted: ${DELETE_TARGET}"
        exit 0
    fi

    # Fallback to rustypaste DELETE method
    resp=$(curl -s -w "\n%{http_code}" -X DELETE -H "Authorization: Bearer ${AUTH_TOKEN}" "${SERVER_URL}/${DELETE_TARGET}")
    http_code=$(echo "$resp" | tail -n1)
    body=$(echo "$resp" | sed '$d')

    if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]; then
        echo "Deleted: ${DELETE_TARGET}"
        exit 0
    else
        echo "Failed to delete ${DELETE_TARGET} (HTTP $http_code): $body" >&2
        exit 1
    fi
fi

# 2. List operation
if [[ "$LIST_FILES" = true ]]; then
    curl -s -H "Authorization: Bearer ${AUTH_TOKEN}" "${SERVER_URL}/list"
    exit 0
fi

# Build common curl arguments
CURL_ARGS=()
if [[ -n "$AUTH_TOKEN" ]]; then
    CURL_ARGS+=(-H "Authorization: Bearer ${AUTH_TOKEN}")
fi
if [[ -n "$EXPIRATION" ]]; then
    CURL_ARGS+=(-F "expires=${EXPIRATION}")
fi
if [[ "$ONESHOT" = true ]]; then
    CURL_ARGS+=(-F "oneshot=true")
fi
if [[ "$SECRET" = true ]]; then
    CURL_ARGS+=(-F "secret=")
fi
if [[ -n "$CUSTOM_NAME" ]]; then
    CURL_ARGS+=(-F "customName=${CUSTOM_NAME}")
fi

# 3. Shorten URL
if [[ -n "$TARGET_URL" ]]; then
    CURL_ARGS+=(-F "shorten=${TARGET_URL}")
    response=$(curl -s -i "${CURL_ARGS[@]}" "${SERVER_URL}/")
    result_url=$(echo "$response" | grep -v '^HTTP/' | grep -v '^[A-Za-z\-]*:' | sed '/^[[:space:]]*$/d' | tr -d '\r')
    x_token=$(echo "$response" | grep -i '^x-token:' | awk '{print $2}' | tr -d '\r' || true)

    echo "$result_url"
    if [[ -n "$x_token" ]]; then
        echo "Management Token (X-Token): $x_token" >&2
    fi
    if [[ "$COPY_CLIPBOARD" = true ]]; then
        copy_to_clip "$result_url"
    fi
    exit 0
fi

# 4. Upload File (argument or stdin)
INPUT_FILE="${1:-}"
TMP_STDIN=""

if [[ -z "$INPUT_FILE" || "$INPUT_FILE" == "-" ]]; then
    if [ -t 0 ]; then
        usage
        exit 1
    fi
    TMP_STDIN=$(mktemp /tmp/picoshare_stdin.XXXXXX.txt)
    cat > "$TMP_STDIN"
    INPUT_FILE="$TMP_STDIN"
fi

if [[ ! -f "$INPUT_FILE" ]]; then
    echo "Error: File not found: $INPUT_FILE" >&2
    exit 1
fi

CURL_ARGS+=(-F "file=@${INPUT_FILE}")

response=$(curl -s -i "${CURL_ARGS[@]}" "${SERVER_URL}/")
if [[ -n "$TMP_STDIN" && -f "$TMP_STDIN" ]]; then
    rm -f "$TMP_STDIN"
fi

http_status=$(echo "$response" | grep '^HTTP/' | tail -n1 | awk '{print $2}')
result_url=$(echo "$response" | grep -v '^HTTP/' | grep -v '^[A-Za-z\-]*:' | sed '/^[[:space:]]*$/d' | tr -d '\r')
x_token=$(echo "$response" | grep -i '^x-token:' | awk '{print $2}' | tr -d '\r' || true)

if [[ "$http_status" -ge 400 ]]; then
    echo "Upload failed (HTTP $http_status): $result_url" >&2
    exit 1
fi

echo "$result_url"
if [[ -n "$x_token" ]]; then
    echo "Management Token (X-Token): $x_token" >&2
fi

if [[ "$COPY_CLIPBOARD" = true ]]; then
    copy_to_clip "$result_url"
fi
